# Copy this file to .env. Only JWT_SECRET is required.
PORT=4000
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=../database/voyara.db

# AI assistant (optional). Without a key the assistant runs in clearly labelled DEMO mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Nominatim (OpenStreetMap search) asks for a contact in the User-Agent.
GEO_CONTACT=your-email@example.com
