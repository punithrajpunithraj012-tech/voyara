# Local backend configuration. Set these as environment variables on Render.
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Render PostgreSQL connection string (required in production)
DATABASE_URL=

# MYRAVO Travel AI (optional; without this, the assistant uses labelled basic replies)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Brevo transactional email (required for production password resets)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MYRAVO

# Nominatim asks for a contact in the User-Agent.
GEO_CONTACT=your-email@example.com
